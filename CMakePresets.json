{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (x64, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PHONELINK_DEPLOY": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "release",
      "displayName": "RelWithDebInfo (symbols, for crash analysis)",
      "binaryDir": "${sourceDir}/build-dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" }
  ]
}
